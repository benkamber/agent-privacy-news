# Copy this file to .env and fill in your key. .env is git-ignored.
# Every script sources .env automatically before running.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: publish the read-only UI to Cloudflare Pages headlessly, without a
# browser login. Create a token at dash.cloudflare.com under My Profile,
# API Tokens, with the Account "Cloudflare Pages: Edit" permission, then set:
# CLOUDFLARE_API_TOKEN=your-cloudflare-pages-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id
